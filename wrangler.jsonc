/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "navihive",
    "main": "worker/index.ts",
    "compatibility_date": "2025-04-05",
    "compatibility_flags": ["nodejs_compat"],  // 必须启用 Node.js 兼容
    "assets": {
        "not_found_handling": "single-page-application"
    },
    "observability": {
        "enabled": true
    },
    // D1数据库绑定
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "navigation-db",
            "database_id": "b0eb183b-8634-4ef9-ae35-4347e5f72845"
        }
    ],
    "vars": {
        "AUTH_ENABLED": "true",
        "AUTH_USERNAME": "eq",
        "AUTH_PASSWORD": "6666eeee",
        "AUTH_SECRET": "$2y$10$9xF7sQ2k.Z8tD5vB1nM3cG6hJ8pL1mN4pR7sU0vW2xY5zA9bC3dEQfG"
    }
}




